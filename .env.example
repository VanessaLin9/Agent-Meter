# This file is intentionally credential-free and safe to commit.
# Copy only non-secret values into local configuration. Provider tokens do not
# belong in a repo-local .env file.

AGENT_METER_MODE=development
AGENT_METER_LIVE_MODE=0
AGENT_METER_ENABLED_PROVIDERS=codex,cursor,claude
AGENT_METER_SECRET_BACKEND=provider_session

AGENT_METER_BIND_HOST=127.0.0.1
AGENT_METER_PORT=8787
AGENT_METER_REFRESH_SECONDS=300

# Optional pointer to configuration stored outside the Git checkout.
# Example on macOS: ~/Library/Application Support/Agent Meter
# Example on Linux: /etc/agent-meter
AGENT_METER_CONFIG_DIR=
