{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-meter.local/schemas/error-v1.schema.json",
  "title": "Agent Meter Service Error Envelope v1",
  "description": "Non-snapshot HTTP error body. Never feed this document to the UsageSnapshot parser.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "$ref": "#/$defs/errorBody"
    }
  },
  "$defs": {
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "no_enabled_providers",
            "snapshot_not_ready",
            "snapshot_unavailable",
            "config_error",
            "revision_conflict",
            "save_failed",
            "cache_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\r\\n]+$",
          "description": "Sanitized human-readable message without secrets, paths, or raw payloads."
        }
      }
    }
  }
}
